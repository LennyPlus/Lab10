<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.mavenproject1.OrderController">
   <children>
      <VBox alignment="CENTER" minHeight="-Infinity" minWidth="-Infinity" spacing="20.0">
         <children>
            <MenuBar VBox.vgrow="NEVER">
              <menus>
                <Menu mnemonicParsing="false" text="File">
                  <items>
                    <MenuItem mnemonicParsing="false" onAction="#onPlaceOrderMenuItem" text="Place Order" />
                        <MenuItem mnemonicParsing="false" onAction="#onClearOrderMenuItem" text="Clear Order" />
                        <MenuItem mnemonicParsing="false" onAction="#onExitMenuItem" text="Exit" />
                  </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Edit">
                  <items>
                    <MenuItem mnemonicParsing="false" text="Entree" />
                        <MenuItem mnemonicParsing="false" text="Drink" />
                        <MenuItem mnemonicParsing="false" text="Special Request" />
                  </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Help">
                  <items>
                    <MenuItem mnemonicParsing="false" text="About" />
                  </items>
                </Menu>
              </menus>
            </MenuBar>
            <HBox alignment="CENTER" spacing="50.0">
               <children>
                  <VBox prefHeight="200.0" prefWidth="100.0">
                     <children>
                        <Label minHeight="-Infinity" minWidth="-Infinity" text="Entree selection" />
                        <ListView fx:id="entreeListView" minHeight="-Infinity" minWidth="-Infinity" prefHeight="100.0" />
                     </children>
                  </VBox>
                  <VBox minHeight="-Infinity" minWidth="-Infinity" prefWidth="80.0">
                     <children>
                        <Label text="Drink Selection" />
                        <RadioButton mnemonicParsing="false" text="Coffee">
                           <toggleGroup>
                              <ToggleGroup fx:id="drinkToggleGroup" />
                           </toggleGroup></RadioButton>
                        <RadioButton layoutX="10.0" layoutY="27.0" mnemonicParsing="false" text="Tea" toggleGroup="$drinkToggleGroup" />
                        <RadioButton layoutX="10.0" layoutY="44.0" mnemonicParsing="false" text="Soda" toggleGroup="$drinkToggleGroup" />
                        <RadioButton layoutX="10.0" layoutY="61.0" mnemonicParsing="false" text="Juice" toggleGroup="$drinkToggleGroup" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <CheckBox mnemonicParsing="false" text="Request Free Water" />
            <VBox style="-fx-background-color: ABABAB; -fx-border-radius: 50;">
               <children>
                  <Label text="Special Requests" />
                  <TextField promptText="e.g Hold the onions" />
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </VBox>
            <HBox spacing="10.0" style="-fx-background-color: ABABAB;">
               <children>
                  <VBox>
                     <children>
                        <Label style="-fx-font-size: 15;" text="Current Order:">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <Label fx:id="totalPriceLabel" text="Total: $0.00" />
                     </children>
                  </VBox>
                  <HBox>
                     <children>
                        <Button fx:id="placeOrderBtn" mnemonicParsing="false" onAction="#onPlaceOrderBtn" style="-: 15;" text="Place Order" />
                        <Button fx:id="clearOrderBtn" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#onClearOrderBtn" text="Clear Order" />
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </HBox>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </children>
</StackPane>
